# config.yaml.example.n-keys.n-pools.n-providers
# Multiple keypools, multiple API keys, multiple providers, one route model.
# Use case: route to Gemini by default; fall back to DeepSeek if Gemini is down.
# Each provider has its own isolated key pool — failures in one never affect another.

server:
  default_model: miroxy

auth:
  allowed_keys:
    - ${MIROXY_CLIENT_KEY}

providers:
  gemini: {}

  deepseek: {}              # uses built-in default (api.deepseek.com/v1, deepseek protocol)

keypools:
  gemini-flash:
    strategy: least_requests
    rate_limit_rpm: 20
    keys:
      - key_1: ${GEMINI_KEY_1}
      - key_2: ${GEMINI_KEY_2}
      - key_3: ${GEMINI_KEY_3}

  deepseek-pool:
    strategy: round_robin
    keys:
      - main:   ${DEEPSEEK_KEY_1}
      - backup: ${DEEPSEEK_KEY_2}

model_routes:
  - model_name: miroxy
    routing:
      strategy: fallback           # try Gemini first; fall through to DeepSeek on failure
      targets:
        - provider: gemini
          provider_model: gemini-2.5-flash
          keypool_ref: gemini-flash
          timeout_seconds: 30
        - provider: deepseek
          provider_model: deepseek-chat
          keypool_ref: deepseek-pool
          timeout_seconds: 30
