# Copy this file to config/secrets.env and fill in real values.
# Pass it to the container with: docker run --env-file config/secrets.env ...
# Never commit config/secrets.env to source control.

# Upstream Gemini API keys (Google AI Studio)
# Variable names must match the ${...} references in config.yaml
GEMINI_KEY_1=your-gemini-api-key-here
GEMINI_KEY_2=your-second-gemini-api-key-here

# Inbound bearer token(s) that clients must present to miroxy
MIROXY_CLIENT_KEY_1=your-client-api-key-here
